{
  "name": "@seedcast/engine",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "seedcast-engine": "./dist/cli.js",
    "seedcast": "./dist/bin/seedcast.js",
    "seedcast-mcp": "./dist/mcp/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "seedcast": "tsx src/bin/seedcast.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "sidecar": "node ./scripts/build-sidecar.mjs",
    "smoke:flow": "pnpm build && node dist/flow/runMockSmoke.js",
    "smoke:pw": "tsx ./scripts/pw-probe.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@seedcast/shared": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "playwright": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
