{
  "id": "bilibili",
  "name": "B站专栏",
  "version": "0.1.0",
  "apiVersion": 1,
  "adapter": "code",
  "entry": "builtin",
  "contentTypes": ["article"],
  "platform": {
    "home": "https://member.bilibili.com/",
    "loginUrl": "https://passport.bilibili.com/login",
    "sessionCheck": {
      "url": "https://member.bilibili.com/platform/home",
      "loggedInSelector": "loggedIn",
      "loggedInCookie": "SESSDATA,bili_jct,DedeUserID",
      "timeoutMs": 15000
    }
  },
  "capabilities": {
    "draft": true,
    "nativeSchedule": false,
    "publishTypes": [
      { "id": "draft", "label": "写入专栏草稿" }
    ]
  }
}
