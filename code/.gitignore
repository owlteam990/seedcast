*.dmg
*.app
*.msi
*.exe
*.AppImage
src-tauri/gen/

# Tauri sidecar / 资源（由 pnpm sidecar 生成，勿提交大二进制）
apps/desktop/src-tauri/binaries/seedcast-engine-*
apps/desktop/src-tauri/resources/plugins/**
!apps/desktop/src-tauri/resources/plugins/.gitkeep
!apps/desktop/src-tauri/binaries/README.md
apps/desktop/dist-bundle/
