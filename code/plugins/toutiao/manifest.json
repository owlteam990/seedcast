{
  "id": "toutiao",
  "name": "今日头条",
  "version": "0.1.0",
  "apiVersion": 1,
  "adapter": "code",
  "entry": "builtin",
  "contentTypes": ["article"],
  "platform": {
    "home": "https://mp.toutiao.com/",
    "loginUrl": "https://mp.toutiao.com/auth/page/login/",
    "sessionCheck": {
      "url": "https://mp.toutiao.com/",
      "loggedInSelector": "loggedIn",
      "loggedInCookie": "sessionid,sessionid_ss,sid_tt,uid_tt",
      "timeoutMs": 15000
    }
  },
  "capabilities": {
    "draft": true,
    "nativeSchedule": false,
    "publishTypes": [
      { "id": "draft", "label": "写入草稿" }
    ]
  }
}
