dist/
build/
out/
target/
.turbo/
.vite/
*.tsbuildinfo

.env
.env.*
!.env.example
*.pem
*.p12
*.key

logs/
*.log
npm-debug.log*
pnpm-debug.log*

local-data/
.seedcast/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
engine.json

coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
**/__screenshots__/
tmp/
temp/
.tmp/
.tmp-smoke/
**/.tmp-smoke/
scripts/local/
**/*.local.sh
**/*.local.ts
**/*.local.js

.DS_Store
Thumbs.db
.idea/
.vscode/*
